# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=4000
# Adresse du frontend en développement (pour CORS)
FRONTEND_URL=http://localhost:3000

# ─── Base de données MySQL (WAMP : root sans mot de passe par défaut) ────────
DB_HOTE=127.0.0.1
DB_PORT=3306
DB_UTILISATEUR=root
DB_MOT_DE_PASSE=
DB_NOM=media_cloud

# ─── Stockage des fichiers ────────────────────────────────────────────────────
# Dossier où sont rangés les fichiers envoyés (relatif à la racine du projet,
# ou chemin absolu, ex : D:/MonNAS/medias)
DOSSIER_STOCKAGE=stockage
# Taille maximale d'un fichier envoyé, en Mo (20480 = 20 Go)
TAILLE_MAX_MO=20480
